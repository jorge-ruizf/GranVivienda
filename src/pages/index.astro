---
import Layout from "../layouts/Layout.astro";
import PropertyCard from "../components/PropertyCard.astro";
import { getFeaturedProperties } from "../data/properties";

const featuredProperties = getFeaturedProperties();
const whatsappUrl = "https://wa.me/573019044655?text=Hola,%20estoy%20interesado%20en%20sus%20servicios%20de%20arriendo.";
---

<Layout title="Inicio">
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <span class="hero__label">Medellín, Colombia</span>
        <h1 class="hero__title">Encuentra tu próximo hogar</h1>
        <p class="hero__subtitle">
          Propiedades en arriendo en las mejores zonas de Medellín. Especialistas en La América y alrededores.
        </p>
        <div class="hero__actions">
          <a href="/propiedades" class="btn btn--primary btn--lg">
            Ver propiedades
          </a>
          <a href={whatsappUrl} class="btn btn--whatsapp btn--lg" target="_blank" rel="noopener noreferrer">
            <svg class="whatsapp-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">Propiedades destacadas</h2>
      <p class="section__subtitle">
        Una selección de las mejores opciones de arriendo disponibles para ti.
      </p>

      <div class="grid grid--3">
        {featuredProperties.map((property) => (
          <PropertyCard property={property} />
        ))}
      </div>

      <div class="home__cta">
        <a href="/propiedades" class="btn btn--outline">
          Ver todas las propiedades
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="section__title">¿Por qué Arrendamientos Gran Vivienda?</h2>
      <p class="section__subtitle">
        Conocemos Medellín y trabajamos para encontrar el hogar ideal para ti.
      </p>

      <div class="features">
        <div class="feature">
          <div class="feature__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <h3 class="feature__title">Zona La América</h3>
          <p class="feature__text">
            Especialistas en la zona de La América y alrededores de Medellín. Conocemos cada barrio.
          </p>
        </div>

        <div class="feature">
          <div class="feature__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <h3 class="feature__title">Hogares verificados</h3>
          <p class="feature__text">
            Cada propiedad en nuestro catálogo pasa por un proceso de verificación para garantizar tu tranquilidad.
          </p>
        </div>

        <div class="feature">
          <div class="feature__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <h3 class="feature__title">Contacto directo</h3>
          <p class="feature__text">
            Comunícate directamente con nosotros por WhatsApp. Respuesta rápida y atención personalizada.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--whatsapp">
    <div class="container">
      <div class="whatsapp-cta">
        <div class="whatsapp-cta__content">
          <h2 class="whatsapp-cta__title">¿Buscas un arriendo en Medellín?</h2>
          <p class="whatsapp-cta__text">
            Escríbenos por WhatsApp y te ayudamos a encontrar la propiedad ideal según tus necesidades y presupuesto.
          </p>
        </div>
        <a href={whatsappUrl} class="btn btn--whatsapp btn--lg" target="_blank" rel="noopener noreferrer">
          <svg class="whatsapp-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding: 5rem 0;
  }

  .hero__content {
    max-width: 640px;
  }

  .hero__label {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.85;
    margin-bottom: 1rem;
  }

  .hero__title {
    font-size: 2.75rem;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero__subtitle {
    font-size: 1.125rem;
    opacity: 0.9;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__actions .btn--lg {
    padding: 1rem 2rem;
    font-size: 1rem;
  }

  .home__cta {
    text-align: center;
    margin-top: 3rem;
  }

  .section--alt {
    background-color: var(--color-white);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .feature {
    text-align: center;
    padding: 2rem 1.5rem;
    border-radius: 12px;
    background-color: var(--color-gray-50);
  }

  .feature__icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary);
    color: var(--color-white);
    border-radius: 12px;
  }

  .feature__icon svg {
    width: 28px;
    height: 28px;
  }

  .feature__title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-gray-900);
  }

  .feature__text {
    font-size: 0.875rem;
    color: var(--color-gray-600);
    line-height: 1.6;
  }

  .section--whatsapp {
    background-color: var(--color-gray-50);
    border-top: 1px solid var(--color-gray-200);
  }

  .whatsapp-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.5rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: 12px;
  }

  .whatsapp-cta__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-gray-900);
    margin-bottom: 0.5rem;
  }

  .whatsapp-cta__text {
    font-size: 1rem;
    color: var(--color-gray-600);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 3rem 0;
    }

    .hero__title {
      font-size: 2rem;
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__actions .btn {
      width: 100%;
      justify-content: center;
    }

    .features {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .whatsapp-cta {
      flex-direction: column;
      text-align: center;
    }

    .whatsapp-cta .btn {
      width: 100%;
    }
  }
</style>
