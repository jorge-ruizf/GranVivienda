---
import Layout from "../../layouts/Layout.astro";
import PropertyGallery from "../../components/PropertyGallery.astro";
import FeatureIcon from "../../components/FeatureIcon.astro";
import {
  getAllProperties,
  getPropertyBySlug,
  getVisibleFeatures,
} from "../../data/properties";
import { formatFeatureSpecValue } from "../../data/features";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  const properties = getAllProperties();
  return properties.map((property) => ({
    params: { slug: property.slug },
  }));
};

const { slug } = Astro.params;
const property = getPropertyBySlug(slug as string);

if (!property) {
  return Astro.redirect("/404");
}

function formatPrice(price: number): string {
  return new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: "COP",
    maximumFractionDigits: 0,
  }).format(price);
}

function getPropertyTypeLabel(type: string): string {
  const labels: Record<string, string> = {
    apartment: "Apartamento",
    house: "Casa",
    studio: "Estudio",
    penthouse: "Penthouse",
  };
  return labels[type] || type;
}

function getOperationLabel(operation: string): string {
  return operation === "sale" ? "Venta" : "Arriendo";
}

function getPricePeriodLabel(operation: string): string {
  return operation === "sale" ? "" : "/mes";
}

function buildWhatsAppUrl(title: string, id: string): string {
  const message = encodeURIComponent(
    `Hola, estoy interesado en la propiedad "${title}" (ID: ${id}). Quisiera recibir más información.`
  );
  return `https://wa.me/573019044655?text=${message}`;
}

const whatsappUrl = buildWhatsAppUrl(property.title, property.id);

const visibleFeatures = getVisibleFeatures(property);
const metaDescription = property.description.join(" ");
---

<Layout
  title={property.title}
  description={metaDescription}
>
  <article class="property-detail">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span class="breadcrumb__separator">/</span>
        <a href="/propiedades">Propiedades</a>
        <span class="breadcrumb__separator">/</span>
        <span class="breadcrumb__current">{property.title}</span>
      </nav>

      <div class="property-detail__header">
        <div class="property-detail__meta">
          <span class="property-detail__badge">
            {getOperationLabel(property.operation)}
          </span>
          <span class="property-detail__type">
            {getPropertyTypeLabel(property.propertyType)}
          </span>
        </div>

        <h1 class="property-detail__title">{property.title}</h1>

        <div class="property-detail__location">
          <svg class="property-detail__location-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>{property.location.neighborhood}, {property.location.city}</span>
        </div>
      </div>

      <div class="property-detail__grid">
        <div class="property-detail__main">
          <PropertyGallery media={property.media} title={property.title} />

          <section class="property-detail__section">
            <h2 class="property-detail__section-title">Descripción</h2>
            <div class="property-detail__description">
              {property.description.map((line) => (
                <p>{line}</p>
              ))}
            </div>
          </section>

          {visibleFeatures.length > 0 && (
            <section class="property-detail__section">
              <h2 class="property-detail__section-title">Características</h2>
              <div class="property-detail__specs">
                {visibleFeatures.map((feature) => (
                  <div class="spec">
                    <div class="spec__icon">
                      <FeatureIcon name={feature.key} />
                    </div>
                    <span class="spec__label">{feature.meta.label}</span>
                    <span class="spec__value">
                      {formatFeatureSpecValue(feature.meta, feature.value)}
                    </span>
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>

        <aside class="property-detail__sidebar">
          <div class="price-card">
            <div class="price-card__price">
              {formatPrice(property.price)}
              {getPricePeriodLabel(property.operation) && (
                <span class="price-card__period">{getPricePeriodLabel(property.operation)}</span>
              )}
            </div>

            <a
              href={whatsappUrl}
              class="btn btn--whatsapp btn--full btn--lg"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="whatsapp-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Consultar disponibilidad por WhatsApp
            </a>

            <p class="price-card__note">
              Precio en pesos colombianos (COP)
            </p>
          </div>
        </aside>
      </div>
    </div>
  </article>
</Layout>

<style>
  .property-detail {
    padding: 2rem 0 4rem;
  }

  .breadcrumb {
    font-size: 0.875rem;
    color: var(--color-gray-500);
    margin-bottom: 2rem;
  }

  .breadcrumb a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb__separator {
    margin: 0 0.5rem;
  }

  .breadcrumb__current {
    color: var(--color-gray-700);
  }

  .property-detail__header {
    margin-bottom: 2rem;
  }

  .property-detail__meta {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .property-detail__badge {
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  .property-detail__type {
    padding: 0.375rem 0.75rem;
    background-color: var(--color-gray-100);
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-gray-700);
  }

  .property-detail__title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-gray-900);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .property-detail__location {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: var(--color-gray-600);
  }

  .property-detail__location-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .property-detail__grid {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 3rem;
    align-items: start;
  }

  .property-detail__section {
    margin-bottom: 2rem;
  }

  .property-detail__section-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .property-detail__description {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-gray-700);
  }

  .property-detail__description p {
    margin: 0 0 0.5rem;
  }

  .property-detail__description p:last-child {
    margin-bottom: 0;
  }

  .property-detail__specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
  }

  .spec {
    text-align: center;
    padding: 1.5rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: 8px;
  }

  .spec__icon {
    width: 40px;
    height: 40px;
    margin: 0 auto 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }

  .spec__icon svg {
    width: 28px;
    height: 28px;
  }

  .spec__label {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-gray-600);
    margin-bottom: 0.25rem;
  }

  .spec__value {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-gray-900);
  }

  .price-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: 12px;
    padding: 1.5rem;
    position: sticky;
    top: 5rem;
  }

  .price-card__price {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
    text-align: center;
  }

  .price-card__period {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-gray-600);
  }

  .price-card__note {
    font-size: 0.75rem;
    color: var(--color-gray-500);
    text-align: center;
    margin-top: 1rem;
  }

  .btn--full {
    width: 100%;
  }

  @media (max-width: 1024px) {
    .property-detail__grid {
      grid-template-columns: 1fr;
    }

    .price-card {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .property-detail__title {
      font-size: 1.5rem;
    }

    .property-detail__specs {
      grid-template-columns: 1fr;
    }
  }
</style>
