---
import type { PropertyMedia } from "../data/properties";
import { getVideoSources, isVideo } from "../data/properties";

interface Props {
  media: PropertyMedia[];
  title: string;
}

const { media, title } = Astro.props;

const hasMedia = media.length > 0;
const hasMultipleMedia = media.length > 1;
---

<div class="gallery" data-gallery={hasMedia ? "" : undefined}>
  <div class="gallery__main">
    {hasMedia ? (
      media.map((item, index) => {
        const video = isVideo(item) ? item : null;
        return (
          <div
            class:list={[
              "gallery__slide",
              { "gallery__slide--active": index === 0 },
            ]}
            data-slide
            data-type={video ? "video" : "image"}
          >
            {video ? (
              <>
                {video.poster ? (
                  <img
                    class="gallery__bg"
                    src={video.poster}
                    alt=""
                    aria-hidden="true"
                  />
                ) : (
                  <video
                    class="gallery__bg"
                    src={video.src}
                    muted
                    playsinline
                    preload="metadata"
                    tabindex="-1"
                    aria-hidden="true"
                  />
                )}
                <video
                  class="gallery__media"
                  data-slide-video
                  controls
                  muted
                  playsinline
                  preload="metadata"
                  poster={video.poster}
                  aria-label={video.alt || title}
                >
                  {getVideoSources(video).map((source) => (
                    <source src={source.src} type={source.type} />
                  ))}
                </video>
              </>
            ) : (
              <>
                <img
                  class="gallery__bg"
                  src={item.src}
                  alt=""
                  aria-hidden="true"
                />
                <img class="gallery__media" src={item.src} alt={item.alt || title} />
              </>
            )}
          </div>
        );
      })
    ) : (
      <div class="gallery__placeholder">
        <svg class="gallery__placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
        <span>Imágenes y videos próximamente</span>
      </div>
    )}
    <span class="gallery__counter" data-gallery-counter>
      {hasMedia ? `1 / ${media.length}` : "0 / 0"}
    </span>
    {hasMultipleMedia && (
      <button class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="Anterior">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
    )}
    {hasMultipleMedia && (
      <button class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="Siguiente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
    )}
  </div>

  {hasMultipleMedia && (
    <div class="gallery__thumbnails">
      {media.map((item, index) => {
        const video = isVideo(item) ? item : null;
        return (
          <button
            class:list={["gallery__thumb", { "gallery__thumb--active": index === 0 }]}
            data-gallery-thumb={index}
            aria-label={`Ver elemento ${index + 1}: ${item.alt}`}
          >
            {video ? (
              <>
                {video.poster ? (
                  <img
                    class="gallery__thumb-image"
                    src={video.poster}
                    alt={video.alt}
                    loading="lazy"
                  />
                ) : (
                  <video
                    class="gallery__thumb-image"
                    src={video.src}
                    muted
                    playsinline
                    preload="metadata"
                    tabindex="-1"
                    aria-hidden="true"
                  />
                )}
                <span class="gallery__thumb-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </span>
              </>
            ) : (
              <img
                class="gallery__thumb-image"
                src={item.src}
                alt={item.alt}
                loading="lazy"
              />
            )}
          </button>
        );
      })}
    </div>
  )}
</div>

<script>
  function initGallery() {
    document.querySelectorAll("[data-gallery]").forEach(function (gallery) {
      if (gallery.hasAttribute("data-gallery-ready")) return;
      gallery.setAttribute("data-gallery-ready", "");

      var slides = gallery.querySelectorAll("[data-slide]");
      var total = slides.length;
      if (!total) return;

      var counter = gallery.querySelector("[data-gallery-counter]");
      var prevBtn = gallery.querySelector("[data-gallery-prev]");
      var nextBtn = gallery.querySelector("[data-gallery-next]");
      var thumbs = gallery.querySelectorAll("[data-gallery-thumb]");

      var current = 0;
      var timer = null;
      var touchTimer = null;
      var hoverActive = false;
      var touchSuspended = false;
      var pendingAdvance = false;

      var states = [];
      for (var s = 0; s < total; s++) {
        states[s] = { pauseCause: null, userPaused: false, pausedByHover: false };
      }

      function isSuspended() {
        return hoverActive || touchSuspended;
      }

      function clearTimer() {
        if (timer !== null) {
          clearTimeout(timer);
          timer = null;
        }
      }

      function typeAt(index) {
        return slides[index].getAttribute("data-type");
      }

      function videoAt(index) {
        var slide = slides[index];
        return slide ? slide.querySelector("[data-slide-video]") : null;
      }

      function playVideo(video) {
        video.muted = true;
        var playback = video.play();
        if (playback && typeof playback.catch === "function") {
          playback.catch(function () {});
        }
      }

      function stopVideos() {
        for (var i = 0; i < total; i++) {
          var video = videoAt(i);
          if (!video) continue;
          if (!video.paused) states[i].pauseCause = "switch";
          video.pause();
          try {
            video.currentTime = 0;
          } catch (error) {
            /* ignore seek errors */
          }
        }
      }

      function playActive() {
        if (typeAt(current) !== "video") return;
        var video = videoAt(current);
        if (!video) return;
        playVideo(video);
      }

      function scheduleImage() {
        clearTimer();
        if (isSuspended() || total < 2 || typeAt(current) !== "image") return;
        timer = setTimeout(function () {
          goTo(current + 1);
        }, 2500);
      }

      function goTo(index) {
        current = ((index % total) + total) % total;
        clearTimer();
        pendingAdvance = false;
        stopVideos();
        states[current] = { pauseCause: null, userPaused: false, pausedByHover: false };
        for (var i = 0; i < total; i++) {
          slides[i].classList.toggle("gallery__slide--active", i === current);
          if (thumbs[i]) {
            thumbs[i].classList.toggle("gallery__thumb--active", i === current);
          }
        }
        if (counter) counter.textContent = current + 1 + " / " + total;
        playActive();
        scheduleImage();
      }

      function suspendForMouse() {
        hoverActive = true;
        clearTimer();
        if (typeAt(current) !== "video") return;
        var video = videoAt(current);
        var state = states[current];
        if (video && !video.paused && !video.ended) {
          state.pauseCause = "hover";
          video.pause();
        }
      }

      function maybeResume() {
        if (isSuspended()) return;
        if (pendingAdvance) {
          pendingAdvance = false;
          goTo(current + 1);
          return;
        }
        if (typeAt(current) === "video") {
          var video = videoAt(current);
          var state = states[current];
          if (
            video &&
            state.pausedByHover &&
            !state.userPaused &&
            video.paused &&
            !video.ended
          ) {
            state.pausedByHover = false;
            playVideo(video);
          }
        }
        scheduleImage();
      }

      for (var i = 0; i < total; i++) {
        (function (index) {
          var video = videoAt(index);
          if (!video) return;
          var state = states[index];

          video.addEventListener("play", function () {
            state.userPaused = false;
            state.pausedByHover = false;
          });

          video.addEventListener("pause", function () {
            if (state.pauseCause === "hover") {
              state.pausedByHover = true;
              state.pauseCause = null;
              return;
            }
            if (state.pauseCause === "switch") {
              state.pauseCause = null;
              return;
            }
            state.userPaused = true;
          });

          video.addEventListener("ended", function () {
            if (index !== current) return;
            if (isSuspended()) {
              pendingAdvance = true;
              return;
            }
            goTo(index + 1);
          });
        })(i);
      }

      gallery.addEventListener("pointerenter", function (event) {
        if (event.pointerType === "mouse") suspendForMouse();
      });

      gallery.addEventListener("pointerleave", function (event) {
        if (event.pointerType !== "mouse") return;
        hoverActive = false;
        maybeResume();
      });

      gallery.addEventListener("touchstart", function () {
        touchSuspended = true;
        clearTimer();
      }, { passive: true });

      gallery.addEventListener("touchend", function () {
        if (touchTimer !== null) clearTimeout(touchTimer);
        touchTimer = setTimeout(function () {
          touchTimer = null;
          touchSuspended = false;
          maybeResume();
        }, 5000);
      }, { passive: true });

      if (prevBtn) {
        prevBtn.addEventListener("click", function () {
          goTo(current - 1);
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener("click", function () {
          goTo(current + 1);
        });
      }

      thumbs.forEach(function (thumb, index) {
        thumb.addEventListener("click", function () {
          goTo(index);
        });
      });

      goTo(0);
    });
  }

  initGallery();
  document.addEventListener("astro:page-load", initGallery);
</script>

<style>
  .gallery {
    width: 50vw;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--color-white);
  }

  .gallery__main {
    position: relative;
    width: 100%;
    max-height: min(70vh, 560px);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-gray-200), var(--color-gray-300));
  }

  .gallery__slide {
    position: absolute;
    inset: 0;
    display: none;
    background-color: var(--color-gray-100);
  }

  .gallery__slide--active {
    display: block;
  }

  .gallery__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(20px) brightness(0.7);
    transform: scale(1.1);
    pointer-events: none;
  }

  .gallery__media {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .gallery__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-gray-400);
    gap: 0.75rem;
  }

  .gallery__placeholder-icon {
    width: 48px;
    height: 48px;
    opacity: 0.5;
  }

  .gallery__placeholder span {
    font-size: 0.875rem;
  }

  .gallery__counter {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background-color: rgba(0, 0, 0, 0.65);
    color: var(--color-white);
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    z-index: 2;
  }

  .gallery__main:has(.gallery__slide--active[data-type="video"]) .gallery__counter {
    bottom: auto;
    top: 12px;
  }

  .gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background-color: rgba(255, 255, 255, 0.9);
    color: var(--color-gray-800);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.2s ease, transform 0.1s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    padding: 0;
  }

  .gallery__arrow:hover {
    background-color: var(--color-white);
  }

  .gallery__arrow:active {
    transform: translateY(-50%) scale(0.94);
  }

  .gallery__arrow svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .gallery__arrow--prev {
    left: 12px;
  }

  .gallery__arrow--next {
    right: 12px;
  }

  .gallery__thumbnails {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem;
    overflow-x: auto;
    overflow-y: hidden;
    height: 82px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-gray-300) transparent;
  }

  .gallery__thumbnails::-webkit-scrollbar {
    height: 4px;
  }

  .gallery__thumbnails::-webkit-scrollbar-track {
    background: transparent;
  }

  .gallery__thumbnails::-webkit-scrollbar-thumb {
    background-color: var(--color-gray-300);
    border-radius: 2px;
  }

  .gallery__thumb {
    position: relative;
    flex-shrink: 0;
    width: 72px;
    height: 62px;
    border: 2px solid transparent;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    background: none;
    transition: border-color 0.2s ease, opacity 0.2s ease;
    opacity: 0.7;
  }

  .gallery__thumb:hover {
    opacity: 1;
  }

  .gallery__thumb--active {
    border-color: var(--color-primary);
    opacity: 1;
  }

  .gallery__thumb-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__thumb-badge {
    position: absolute;
    right: 3px;
    bottom: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.65);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery__thumb-badge svg {
    width: 10px;
    height: 10px;
  }

  @media (max-width: 1000px) {
    .gallery {
      width: 88vw;
    }
  }

  @media (max-width: 640px) {

    .gallery__main {
      aspect-ratio: 4 / 3;
    }

    .gallery__thumb {
      width: 60px;
      height: 52px;
    }

    .gallery__arrow {
      width: 34px;
      height: 34px;
    }

    .gallery__arrow svg {
      width: 16px;
      height: 16px;
    }

    .gallery__arrow--prev {
      left: 8px;
    }

    .gallery__arrow--next {
      right: 8px;
    }
  }
</style>
