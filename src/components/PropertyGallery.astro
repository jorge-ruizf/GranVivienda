---
import type { PropertyMedia } from "../data/properties";
import { getYoutubeId, isYoutube } from "../data/properties";
import {
  getYoutubeThumb,
  resolveYoutubeOrientation,
  type YoutubeOrientation,
} from "../data/youtube";

interface Props {
  media: PropertyMedia[];
  title: string;
}

const { media, title } = Astro.props;

const hasMedia = media.length > 0;
const hasMultipleMedia = media.length > 1;

type SlideModel =
  | { kind: "image"; src: string; alt: string }
  | {
      kind: "youtube";
      id: string | null;
      orientation: YoutubeOrientation | null;
      alt: string;
    };

const slides: SlideModel[] = media.map((item): SlideModel => {
  if (isYoutube(item)) {
    const id = getYoutubeId(item);
    return {
      kind: "youtube",
      id,
      orientation: id ? resolveYoutubeOrientation(item.url, item.orientation) : null,
      alt: item.alt,
    };
  }
  return { kind: "image", src: item.src, alt: item.alt };
});
---

<div class="gallery" data-gallery={hasMedia ? "" : undefined}>
  <div class="gallery__main">
    {hasMedia ? (
      slides.map((slide, index) => (
        <div
          class:list={[
            "gallery__slide",
            { "gallery__slide--active": index === 0 },
          ]}
          data-slide
          data-type={slide.kind}
        >
          {slide.kind === "youtube" ? (
            slide.id ? (
              <>
                <img
                  class="gallery__bg"
                  src={getYoutubeThumb(slide.id)}
                  alt=""
                  aria-hidden="true"
                />
                <div
                  class:list={[
                    "gallery__yt-frame",
                    { "gallery__yt-frame--portrait": slide.orientation === "portrait" },
                  ]}
                >
                  <div data-yt-player data-video-id={slide.id}></div>
                  <p class="gallery__yt-fallback">Video de YouTube no disponible</p>
                </div>
              </>
            ) : (
              <div class="gallery__placeholder">
                <svg
                  class="gallery__placeholder-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M10 8.5l6 3.5-6 3.5z" fill="currentColor" stroke="none"/>
                </svg>
                <span>Video de YouTube próximamente</span>
              </div>
            )
          ) : (
            <>
              <img
                class="gallery__bg"
                src={slide.src}
                alt=""
                aria-hidden="true"
              />
              <img class="gallery__media" src={slide.src} alt={slide.alt || title} />
            </>
          )}
        </div>
      ))
    ) : (
      <div class="gallery__placeholder">
        <svg class="gallery__placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
        <span>Imágenes próximamente</span>
      </div>
    )}
    <span class="gallery__counter" data-gallery-counter>
      {hasMedia ? `1 / ${media.length}` : "0 / 0"}
    </span>
    {hasMultipleMedia && (
      <button class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="Anterior">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
    )}
    {hasMultipleMedia && (
      <button class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="Siguiente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
    )}
  </div>

  {hasMultipleMedia && (
    <div class="gallery__thumbnails">
      {slides.map((slide, index) => (
        <button
          class:list={["gallery__thumb", { "gallery__thumb--active": index === 0 }]}
          data-gallery-thumb={index}
          aria-label={`Ver elemento ${index + 1}: ${slide.alt}`}
        >
          {slide.kind === "youtube" ? (
            slide.id ? (
              <>
                <img
                  class="gallery__thumb-image"
                  src={getYoutubeThumb(slide.id)}
                  alt={slide.alt}
                  loading="lazy"
                />
                <span class="gallery__thumb-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </span>
              </>
            ) : (
              <span class="gallery__thumb-image gallery__thumb-empty" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </span>
            )
          ) : (
            <img
              class="gallery__thumb-image"
              src={slide.src}
              alt={slide.alt}
              loading="lazy"
            />
          )}
        </button>
      ))}
    </div>
  )}
</div>

<script>
  function initGallery() {
    document.querySelectorAll("[data-gallery]").forEach(function (gallery) {
      if (gallery.hasAttribute("data-gallery-ready")) return;
      gallery.setAttribute("data-gallery-ready", "");

      var slides = gallery.querySelectorAll("[data-slide]");
      var total = slides.length;
      if (!total) return;

      var counter = gallery.querySelector("[data-gallery-counter]");
      var prevBtn = gallery.querySelector("[data-gallery-prev]");
      var nextBtn = gallery.querySelector("[data-gallery-next]");
      var thumbs = gallery.querySelectorAll("[data-gallery-thumb]");

      var current = 0;
      var timer = null;
      var touchTimer = null;
      var hoverActive = false;
      var touchSuspended = false;
      var pendingAdvance = false;

      var yt = [];
      for (var i = 0; i < total; i++) {
        var playerEl = slides[i].querySelector("[data-yt-player]");
        yt[i] = {
          el: playerEl,
          id: playerEl ? playerEl.getAttribute("data-video-id") : null,
          player: null,
          creating: false,
          pendingPlay: false,
          failed: false,
          expectPause: false,
          hoverPaused: false,
          userPaused: false
        };
      }

      function isSuspended() {
        return hoverActive || touchSuspended;
      }

      function clearTimer() {
        if (timer !== null) {
          clearTimeout(timer);
          timer = null;
        }
      }

      function typeAt(index) {
        return slides[index].getAttribute("data-type");
      }

      function ytInfo(index) {
        return yt[index] || null;
      }

      function ytPlayable(index) {
        var info = ytInfo(index);
        return Boolean(info && info.id && !info.failed);
      }

      function playerState(info) {
        try {
          return info.player.getPlayerState();
        } catch (error) {
          return null;
        }
      }

      function loadYoutubeApi() {
        if (window.YT && window.YT.Player) return Promise.resolve();
        if (!window.__galleryYtApi) {
          window.__galleryYtApi = new Promise(function (resolve, reject) {
            var previous = window.onYouTubeIframeAPIReady;
            window.onYouTubeIframeAPIReady = function () {
              if (previous) previous();
              resolve();
            };
            var tag = document.createElement("script");
            tag.src = "https://www.youtube.com/iframe_api";
            tag.onerror = function () {
              window.__galleryYtApi = null;
              reject(new Error("YouTube IFrame API failed to load"));
            };
            document.head.appendChild(tag);
          });
        }
        return window.__galleryYtApi;
      }

      function startPlay(info) {
        try {
          info.player.mute();
          info.player.loadVideoById(info.id);
        } catch (error) {
          /* ignore player errors */
        }
      }

      function handleYtState(index, data) {
        var info = ytInfo(index);
        if (!info) return;
        var ytStates = window.YT && window.YT.PlayerState;
        if (!ytStates) return;

        if (data === ytStates.ENDED) {
          info.expectPause = false;
          info.hoverPaused = false;
          info.userPaused = false;
          if (index !== current) return;
          if (isSuspended()) {
            pendingAdvance = true;
            return;
          }
          goTo(index + 1);
          return;
        }

        if (data === ytStates.PLAYING) {
          info.expectPause = false;
          info.hoverPaused = false;
          info.userPaused = false;
          return;
        }

        if (data === ytStates.PAUSED) {
          if (info.expectPause) {
            info.expectPause = false;
            info.hoverPaused = true;
          } else {
            info.userPaused = true;
          }
        }
      }

      function handleYtError(index) {
        var info = ytInfo(index);
        if (!info) return;
        info.failed = true;
        info.creating = false;
        info.pendingPlay = false;
        if (info.player) {
          try {
            info.player.destroy();
          } catch (error) {
            /* ignore destroy errors */
          }
          info.player = null;
        }
        var frame = slides[index].querySelector(".gallery__yt-frame");
        if (frame) frame.classList.add("gallery__yt-frame--failed");
        if (index === current) scheduleImage();
      }

      function ensurePlayer(index) {
        var info = ytInfo(index);
        if (!info || !info.el || !info.id || info.failed || info.player || info.creating) return;
        info.creating = true;
        loadYoutubeApi()
          .then(function () {
            try {
              info.player = new window.YT.Player(info.el, {
                videoId: info.id,
                host: "https://www.youtube-nocookie.com",
                playerVars: {
                  autoplay: 0,
                  controls: 1,
                  enablejsapi: 1,
                  modestbranding: 1,
                  playsinline: 1,
                  rel: 0
                },
                events: {
                  onReady: function (event) {
                    info.creating = false;
                    try {
                      event.target.mute();
                    } catch (error) {
                      /* ignore mute errors */
                    }
                    if (!info.pendingPlay) return;
                    info.pendingPlay = false;
                    if (index !== current || info.failed) return;
                    if (hoverActive) {
                      info.hoverPaused = true;
                      return;
                    }
                    startPlay(info);
                  },
                  onStateChange: function (event) {
                    handleYtState(index, event.data);
                  },
                  onError: function () {
                    handleYtError(index);
                  }
                }
              });
            } catch (error) {
              handleYtError(index);
            }
          })
          .catch(function () {
            handleYtError(index);
          });
      }

      function stopAllYoutube() {
        for (var i = 0; i < total; i++) {
          var info = ytInfo(i);
          if (!info) continue;
          info.pendingPlay = false;
          info.expectPause = false;
          info.hoverPaused = false;
          info.userPaused = false;
          if (info.player) {
            try {
              info.player.stopVideo();
            } catch (error) {
              /* ignore stop errors */
            }
          }
        }
      }

      function playActive() {
        if (typeAt(current) !== "youtube") return;
        var info = ytInfo(current);
        if (!info || !info.id || info.failed) return;
        info.pendingPlay = false;
        info.expectPause = false;
        info.hoverPaused = false;
        info.userPaused = false;
        ensurePlayer(current);
        if (hoverActive) {
          info.hoverPaused = true;
          return;
        }
        if (info.player) {
          startPlay(info);
          return;
        }
        info.pendingPlay = true;
      }

      function scheduleImage() {
        clearTimer();
        if (isSuspended() || total < 2) return;
        var type = typeAt(current);
        if (type === "youtube") {
          if (ytPlayable(current)) return;
        } else if (type !== "image") {
          return;
        }
        timer = setTimeout(function () {
          goTo(current + 1);
        }, 2500);
      }

      function goTo(index) {
        current = ((index % total) + total) % total;
        clearTimer();
        pendingAdvance = false;
        stopAllYoutube();
        for (var i = 0; i < total; i++) {
          slides[i].classList.toggle("gallery__slide--active", i === current);
          if (thumbs[i]) {
            thumbs[i].classList.toggle("gallery__thumb--active", i === current);
          }
        }
        if (counter) counter.textContent = current + 1 + " / " + total;
        playActive();
        scheduleImage();
      }

      function suspendForMouse() {
        hoverActive = true;
        clearTimer();
        if (typeAt(current) !== "youtube") return;
        var info = ytInfo(current);
        if (!info || !info.player || info.failed) return;
        var ytStates = window.YT && window.YT.PlayerState;
        if (!ytStates) return;
        if (playerState(info) === ytStates.PLAYING) {
          info.expectPause = true;
          try {
            info.player.pauseVideo();
          } catch (error) {
            info.expectPause = false;
          }
        }
      }

      function maybeResume() {
        if (isSuspended()) return;
        if (pendingAdvance) {
          pendingAdvance = false;
          goTo(current + 1);
          return;
        }
        if (typeAt(current) === "youtube") {
          var info = ytInfo(current);
          if (
            info &&
            info.player &&
            !info.failed &&
            info.hoverPaused &&
            !info.userPaused
          ) {
            info.hoverPaused = false;
            try {
              info.player.playVideo();
            } catch (error) {
              /* ignore play errors */
            }
          }
        }
        scheduleImage();
      }

      gallery.addEventListener("pointerenter", function (event) {
        if (event.pointerType === "mouse") suspendForMouse();
      });

      gallery.addEventListener("pointerleave", function (event) {
        if (event.pointerType !== "mouse") return;
        hoverActive = false;
        maybeResume();
      });

      gallery.addEventListener("touchstart", function () {
        touchSuspended = true;
        clearTimer();
      }, { passive: true });

      gallery.addEventListener("touchend", function () {
        if (touchTimer !== null) clearTimeout(touchTimer);
        touchTimer = setTimeout(function () {
          touchTimer = null;
          touchSuspended = false;
          maybeResume();
        }, 5000);
      }, { passive: true });

      if (prevBtn) {
        prevBtn.addEventListener("click", function () {
          goTo(current - 1);
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener("click", function () {
          goTo(current + 1);
        });
      }

      thumbs.forEach(function (thumb, index) {
        thumb.addEventListener("click", function () {
          goTo(index);
        });
      });

      goTo(0);
    });
  }

  initGallery();
  document.addEventListener("astro:page-load", initGallery);
</script>

<style>
  .gallery {
    width: 50vw;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--color-white);
  }

  .gallery__main {
    position: relative;
    width: 100%;
    max-height: min(70vh, 560px);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-gray-200), var(--color-gray-300));
  }

  .gallery__slide {
    position: absolute;
    inset: 0;
    display: none;
    background-color: var(--color-gray-100);
  }

  .gallery__slide--active {
    display: block;
  }

  .gallery__slide--active[data-type="youtube"] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(20px) brightness(0.7);
    transform: scale(1.1);
    pointer-events: none;
  }

  .gallery__media {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .gallery__yt-frame {
    position: relative;
    width: 100%;
    max-height: 100%;
    aspect-ratio: 16 / 9;
  }

  .gallery__yt-frame--portrait {
    width: auto;
    height: 100%;
    aspect-ratio: 9 / 16;
  }

  .gallery__yt-frame [data-yt-player],
  .gallery__yt-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .gallery__yt-fallback {
    display: none;
    position: absolute;
    inset: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem;
    background-color: var(--color-gray-200);
    color: var(--color-gray-400);
    font-size: 0.875rem;
  }

  .gallery__yt-frame--failed [data-yt-player],
  .gallery__yt-frame--failed iframe {
    display: none;
  }

  .gallery__yt-frame--failed .gallery__yt-fallback {
    display: flex;
  }

  .gallery__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-gray-400);
    gap: 0.75rem;
  }

  .gallery__placeholder-icon {
    width: 48px;
    height: 48px;
    opacity: 0.5;
  }

  .gallery__placeholder span {
    font-size: 0.875rem;
  }

  .gallery__counter {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background-color: rgba(0, 0, 0, 0.65);
    color: var(--color-white);
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    z-index: 2;
  }

  .gallery__main:has(.gallery__slide--active[data-type="youtube"]) .gallery__counter {
    bottom: auto;
    top: 12px;
  }

  .gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background-color: rgba(255, 255, 255, 0.9);
    color: var(--color-gray-800);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.2s ease, transform 0.1s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    padding: 0;
  }

  .gallery__arrow:hover {
    background-color: var(--color-white);
  }

  .gallery__arrow:active {
    transform: translateY(-50%) scale(0.94);
  }

  .gallery__arrow svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .gallery__arrow--prev {
    left: 12px;
  }

  .gallery__arrow--next {
    right: 12px;
  }

  .gallery__thumbnails {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem;
    overflow-x: auto;
    overflow-y: hidden;
    height: 82px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-gray-300) transparent;
  }

  .gallery__thumbnails::-webkit-scrollbar {
    height: 4px;
  }

  .gallery__thumbnails::-webkit-scrollbar-track {
    background: transparent;
  }

  .gallery__thumbnails::-webkit-scrollbar-thumb {
    background-color: var(--color-gray-300);
    border-radius: 2px;
  }

  .gallery__thumb {
    position: relative;
    flex-shrink: 0;
    width: 72px;
    height: 62px;
    border: 2px solid transparent;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    background: none;
    transition: border-color 0.2s ease, opacity 0.2s ease;
    opacity: 0.7;
  }

  .gallery__thumb:hover {
    opacity: 1;
  }

  .gallery__thumb--active {
    border-color: var(--color-primary);
    opacity: 1;
  }

  .gallery__thumb-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__thumb-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-gray-200), var(--color-gray-300));
    color: var(--color-gray-400);
  }

  .gallery__thumb-empty svg {
    width: 18px;
    height: 18px;
    opacity: 0.7;
  }

  .gallery__thumb-badge {
    position: absolute;
    right: 3px;
    bottom: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.65);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery__thumb-badge svg {
    width: 10px;
    height: 10px;
  }

  @media (max-width: 1000px) {
    .gallery {
      width: 88vw;
    }
  }

  @media (max-width: 640px) {

    .gallery__main {
      aspect-ratio: 4 / 3;
    }

    .gallery__thumb {
      width: 60px;
      height: 52px;
    }

    .gallery__arrow {
      width: 34px;
      height: 34px;
    }

    .gallery__arrow svg {
      width: 16px;
      height: 16px;
    }

    .gallery__arrow--prev {
      left: 8px;
    }

    .gallery__arrow--next {
      right: 8px;
    }
  }
</style>
