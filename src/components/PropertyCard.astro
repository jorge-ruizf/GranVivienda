---
import type { Property } from "../data/properties";
import { getFirstImage, getVisibleFeatures } from "../data/properties";
import { formatFeatureCardLabel } from "../data/features";
import FeatureIcon from "./FeatureIcon.astro";

interface Props {
  property: Property;
}

const { property } = Astro.props;

const mainImage = getFirstImage(property);
const cardFeatures = getVisibleFeatures(property, { card: true });

function formatPrice(price: number): string {
  return new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: "COP",
    maximumFractionDigits: 0,
  }).format(price);
}

function getPropertyTypeLabel(type: string): string {
  const labels: Record<string, string> = {
    apartment: "Apartamento",
    house: "Casa",
    studio: "Estudio",
    penthouse: "Penthouse",
  };
  return labels[type] || type;
}

function getOperationLabel(operation: string): string {
  return operation === "sale" ? "Venta" : "Arriendo";
}

function getPricePeriodLabel(operation: string): string {
  return operation === "sale" ? "" : "/mes";
}
---

<article class="property-card">
  <a href={`/propiedades/${property.slug}`} class="property-card__link">
    <div class="property-card__image">
      {mainImage ? (
        <img
          class="property-card__img"
          src={mainImage.src}
          alt={mainImage.alt}
          loading="lazy"
        />
      ) : (
        <div class="property-card__placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="property-card__placeholder-icon">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
        </div>
      )}
      <span class="property-card__badge">
        {getOperationLabel(property.operation)}
      </span>
    </div>

    <div class="property-card__content">
      <div class="property-card__header">
        <span class="property-card__type">
          {getPropertyTypeLabel(property.propertyType)}
        </span>
        <h3 class="property-card__title">{property.title}</h3>
      </div>

      <div class="property-card__location">
        <svg class="property-card__location-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span>{property.location.neighborhood}, {property.location.city}</span>
      </div>

      {cardFeatures.length > 0 && (
        <div class="property-card__details">
          {cardFeatures.map((feature) => (
            <span class="property-card__detail">
              <FeatureIcon name={feature.key} class="property-card__detail-icon" />
              {feature.meta.display !== "flag" && <strong>{feature.value}</strong>}
              {" "}{formatFeatureCardLabel(feature.meta, feature.value)}
            </span>
          ))}
        </div>
      )}

      <div class="property-card__price">
        {formatPrice(property.price)}
        {getPricePeriodLabel(property.operation) && (
          <span class="property-card__price-period">{getPricePeriodLabel(property.operation)}</span>
        )}
      </div>
    </div>
  </a>
</article>

<style>
  .property-card {
    background: var(--color-white);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .property-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .property-card__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .property-card__image {
    position: relative;
    height: 200px;
    background: linear-gradient(135deg, var(--color-gray-200), var(--color-gray-300));
    overflow: hidden;
  }

  .property-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .property-card:hover .property-card__img {
    transform: scale(1.05);
  }

  .property-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-gray-400);
  }

  .property-card__placeholder-icon {
    width: 40px;
    height: 40px;
    opacity: 0.4;
  }

  .property-card__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  .property-card__content {
    padding: 1.25rem;
  }

  .property-card__header {
    margin-bottom: 0.5rem;
  }

  .property-card__type {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .property-card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin: 0.25rem 0 0;
    line-height: 1.4;
  }

  .property-card__location {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-gray-500);
    margin-bottom: 1rem;
  }

  .property-card__location-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .property-card__details {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .property-card__detail {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-gray-600);
  }

  .property-card__detail-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .property-card__detail strong {
    color: var(--color-gray-900);
  }

  .property-card__price {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .property-card__price-period {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-gray-500);
  }
</style>
