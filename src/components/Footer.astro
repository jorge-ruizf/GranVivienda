---
const currentYear = new Date().getFullYear();
const whatsappUrl = "https://wa.me/573019044655";
const emailUrl = "mailto:arrendamientosgranvivienda@gmail.com";
---

<footer class="footer" id="contacto">
  <div class="container">
    <div class="footer__content">
      <div class="footer__brand">
        <img class="footer__logo-img" src="/logo.svg" alt="Arrendamientos Gran Vivienda" />
        <p class="footer__tagline">
          Propiedades en arriendo en Medellín. Especialistas en la zona de La América.
        </p>
        <div class="footer__address">
          <p>
            <svg class="footer__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            Calle 32E #80A-15, Medellín
          </p>
        </div>
      </div>

      <div class="footer__links">
        <div class="footer__section">
          <h3 class="footer__title">Navegación</h3>
          <ul class="footer__list">
            <li><a href="/">Inicio</a></li>
            <li><a href="/propiedades">Propiedades</a></li>
          </ul>
        </div>

        <div class="footer__section">
          <h3 class="footer__title">Contacto</h3>
          <ul class="footer__list footer__contact-list">
            <li>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
                <svg class="footer__icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                WhatsApp
              </a>
            </li>
            <li>
              <a href={emailUrl}>
                <svg class="footer__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
                Email
              </a>
            </li>
            <li>
              <span class="footer__social-text">
                <svg class="footer__icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                @arrendamientosgranvivienda
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {currentYear} Arrendamientos Gran Vivienda. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-gray-900);
    color: var(--color-gray-300);
    margin-top: auto;
  }

  .footer .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 1.5rem;
  }

  .footer__content {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    margin-bottom: 2rem;
  }

  .footer__logo-img {
    height: 48px;
    width: auto;
    margin-bottom: 0.75rem;
  }

  .footer__tagline {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-gray-400);
    margin-bottom: 1rem;
  }

  .footer__address p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-gray-400);
  }

  .footer__links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .footer__title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-white);
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__list li {
    margin-bottom: 0.625rem;
    font-size: 0.875rem;
  }

  .footer__list a {
    color: var(--color-gray-400);
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__list a:hover {
    color: var(--color-white);
  }

  .footer__social-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-gray-400);
    font-size: 0.875rem;
  }

  .footer__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .footer__bottom {
    border-top: 1px solid var(--color-gray-700);
    padding-top: 1.5rem;
    text-align: center;
  }

  .footer__bottom p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-gray-500);
  }

  @media (max-width: 768px) {
    .footer__content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer__links {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
