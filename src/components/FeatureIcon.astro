---
import { FEATURES, type FeatureKey } from "../data/features";

interface Props {
  name: FeatureKey;
  class?: string;
}

const { name, class: className } = Astro.props;
const icon = FEATURES[name]?.icon ?? "";
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icon}
/>
